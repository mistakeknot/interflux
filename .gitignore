__pycache__/
*.pyc
.pytest_cache/
.env
.env.*
!.env.example

# Ephemeral verdict/review data
.clavain/verdicts/
.clavain/quality-gates/
.clavain/reviews/

# Flux-drive review outputs (may contain security findings — T4.1)
docs/research/flux-drive/

# Local workspace artifacts
.claude/
.clavain/

# FluxBench results (accumulates real scoring data — do not commit)
/data/

# MCP server build artifacts
/mcp-servers/*/dist/
/mcp-servers/*/node_modules/

# Stray .lock sidecars (e.g. config/flux-drive/model-registry.yaml.lock).
# These are zero-byte flock fd markers that should never be committed.
*.lock
# Keep lockfiles for supply chain safety — this negation MUST come after *.lock above.
!/mcp-servers/*/package-lock.json

# Human-approval marker for agent-mutated publishes (local-only)
.publish-approved

# interwatch scan output (generated, machine-local).
#
# drift.json is the current drift score per watchable and last-scan.json is the
# baseline it compares against; both are rewritten by every interwatch-drift
# run. watchables.yaml above them is hand-authored config and stays tracked.
#
# They were never deliberately committed. The only commit that has ever touched
# them is f8621e8 "chore(sync): auto-commit .interwatch/..." -- swept in by the
# `git add -A` autosync that the current allowlist (2026-07-27) exists to
# replace. Since then the scheduled scan has rewritten them, autosync has
# correctly refused to commit paths that are not on that allowlist, and
# git-autosync-repair has reported NEEDS-HUMAN on this repo on every run.
.interwatch/drift.json
.interwatch/last-scan.json

# interlock-installed coordination hooks and the backups it makes of tracked
# hooks — machine-local tooling, not project source (.githooks/pre-commit IS tracked)
.githooks/post-commit
.githooks/*.interlock-backup

# beads embedded database: local state. A tracked export (.beads/*.jsonl) stays allowed,
# matching how sibling repos commit the export but never the dolt store.
.beads/*
# Only the canonical export is re-includable; interactions.jsonl and friends are
# local telemetry, not a project artifact.
!.beads/beads.jsonl
!.beads/issues.jsonl
